function tickFps(ts){
  fpsFrames++;
  if(ts-fpsLast>=1000){
    fpsVal=fpsFrames;fpsFrames=0;fpsLast=ts;
    if(fpsOn) document.getElementById('fpsDisplay').textContent=fpsVal;
  }
}
function setFpsDisplay(on){
  fpsOn=on;
  const el=document.getElementById('fpsDisplay');
  el.style.display=on?'block':'none';
  el.textContent='--';
}

