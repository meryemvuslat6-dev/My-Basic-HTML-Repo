      <span id="mAbout">HAKKINDA</span><span class="mi-arr">▶</span>
    </div>
  </div>
</div>

<!-- SUB -->
<div id="subScreen" class="screen hidden">
  <div class="sub-title" id="subTitle"></div>
  <div class="sub-list" id="subList"></div>
  <div class="sub-back" id="subBack">◀ GERİ</div>
</div>

<!-- ABOUT -->
<div id="aboutScreen" class="screen hidden">
  <div class="about-logo">TETRIS</div>
  <div class="about-box">
    <div class="about-row">
      <div class="about-lbl">YAPIMCI</div>
      <div class="about-val">PCMekası</div>
    </div>
    <div class="about-div"></div>
    <div class="about-row">
      <div class="about-lbl">SİTE</div>
      <a class="about-link" href="https://pcmekasiyt.blogspot.com" target="_blank">pcmekasiyt.blogspot.com</a>
    </div>
    <div class="about-div"></div>
    <div class="about-row">
      <div class="about-lbl">YOUTUBE</div>
      <a class="about-link" href="https://youtube.com/@PCMekasiOffical" target="_blank">@PCMekasiOffical</a>
    </div>
  </div>
  <div class="about-back" id="aboutBack">◀ GERİ</div>
</div>

<!-- GAME -->
<div id="gameScreen" class="screen hidden">
  <div class="hud">
    <div class="hb"><div class="hl" id="hSL">SKOR</div><div class="hv" id="hS">0</div></div>
    <div class="hb"><div class="hl" id="hLL">SEVİYE</div><div class="hv" id="hL">1</div></div>
    <div class="hb"><div class="hl" id="hNL">SATIR</div><div class="hv" id="hN">0</div></div>
    <div class="hb"><div class="hl" id="hHL">REKOR</div><div class="hv" id="hH">0</div></div>
    <div class="hud-icons">
      <div class="hb"><div class="hl">FPS</div><div id="fpsDisplay">--</div></div>
      <div class="hic" id="btnM">🎵</div>
      <div class="hic" id="btnSX">🔊</div>
    </div>
    <div class="hud-pause" id="btnP">⏸</div>
  </div>
  <div class="play-area">
    <div class="board-wrap" id="bw">
      <canvas id="gc"></canvas>
      <div id="omsg"><div class="om-main" id="omM"></div><div class="om-sub" id="omS"></div></div>
      <div id="ctxt"></div>
    </div>
    <div class="side-col">
      <div class="pbox"><div class="pbox-lbl" id="lNx">SONRAKI</div><canvas id="nc"></canvas></div>
      <div class="pbox"><div class="pbox-lbl" id="lHd">BEKLE</div><canvas id="hc"></canvas></div>
    </div>
  </div>
  <div class="dpad-wrap">
    <div class="dpad" id="dpadGrid">
      <div class="cb" data-a="up">↻</div>
      <div class="cb" data-a="left">◀</div>
      <div class="cb" data-a="right">▶</div>
      <div class="cb" data-a="down">▼</div>
    </div>
    <div class="act-row">
      <div class="ab ab-hold" data-a="hold"><span class="ab-icon">📦</span><span id="lHB">BEKLET</span></div>
      <div class="ab ab-drop" data-a="drop"><span class="ab-icon">⬇</span><span id="lDB">DÜŞÜR</span></div>
    </div>
  </div>
</div>

<!-- PAUSE -->
<div id="pauseScreen" class="screen hidden">
  <div class="pause-title" id="lPause">— DURAKLADI —</div>
  <div class="menu-list" style="margin-top:10px;width:min(78vw,270px);">
    <div class="mi" id="resumeBtn"><span id="lRes">DEVAM</span></div>
    <div class="mi" id="pmenuBtn"><span id="lPM">MENÜ</span></div>
  </div>
</div>

<!-- GAME OVER -->
<div id="gameOverScreen" class="screen hidden">
  <div class="go-title" id="goT">GAME OVER</div>
  <div class="go-score" id="goSc"></div>
  <div class="go-btn" id="goRe" style="margin-top:8px;"></div>
  <div class="go-btn" id="goMn" style="margin-top:5px;"></div>
</div>

