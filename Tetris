      <div class="mi-ic"><div class="mi-dot" style="background:#5eb8ff"></div><div class="mi-dot" style="background:#ff5f8a"></div><div class="mi-dot" style="background:#4dffb0"></div><div class="mi-dot" style="background:#ffd166"></div></div>
      <span id="mStart">OYNA</span><span class="mi-arr">▶</span>
    </div>
    <div class="mi" data-a="diff">
      <div class="mi-ic"><div class="mi-dot" style="background:#4dffb0"></div><div class="mi-dot" style="background:#ffd166"></div><div class="mi-dot" style="background:#ff5f8a"></div><div class="mi-dot" style="background:#ff5f8a"></div></div>
      <span id="mDiff">ZORLUK</span><span class="mi-arr">▶</span>
    </div>
    <div class="mi" data-a="palette">
      <div class="mi-ic"><div class="mi-dot" style="background:#b0ff30"></div><div class="mi-dot" style="background:#c060ff"></div><div class="mi-dot" style="background:#ffcc00"></div><div class="mi-dot" style="background:#5588ff"></div></div>
      <span id="mPal">RENKLER</span><span class="mi-arr">▶</span>
    </div>
    <div class="mi" data-a="lang">
      <div class="mi-ic"><div class="mi-dot" style="background:#5588ff"></div><div class="mi-dot" style="background:#5588ff"></div><div class="mi-dot" style="background:#5588ff"></div><div class="mi-dot" style="background:#5588ff"></div></div>
      <span id="mLang">DİL</span><span class="mi-arr">▶</span>
    </div>
    <div class="mi" data-a="settings">
      <div class="mi-ic"><div class="mi-dot" style="background:#a66cff"></div><div class="mi-dot" style="background:#a66cff"></div><div class="mi-dot" style="background:#a66cff"></div><div class="mi-dot" style="background:#a66cff"></div></div>
      <span id="mSet">AYARLAR</span><span class="mi-arr">▶</span>
    </div>
    <div class="mi" data-a="about">
